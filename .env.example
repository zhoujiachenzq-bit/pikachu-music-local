# 珍奇总开关与管理员（多个用户名用英文逗号分隔）
AGENT_ENABLED=true
AGENT_ADMIN_USERNAMES=
AGENT_MONTHLY_BUDGET_CNY=150

# 对话模型路由：deepseek / bailian / custom / auto。
# 显式选择的服务不可用时只进入本地降级，不会把私密对话自动转发给另一家服务。
AGENT_MODEL_PROVIDER=deepseek

# 生产环境必填。生成 32 字节随机值后以 Base64 保存，密钥必须单独离线备份。
AGENT_DATA_KEY_VERSION=v1
AGENT_DATA_KEY=
# 轮换时可同时保留旧密钥，例如 {"v1":"旧Base64","v2":"新Base64"}
AGENT_DATA_KEYS=

# DeepSeek 负责文字聊天、推理和受控工具规划。V4 默认模型当前不处理图片和语音。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PLUS=deepseek-v4-pro
# 费用为本地预算估算值，可按控制台实际价格修改（单位：元/百万 Token）。
DEEPSEEK_FLASH_INPUT_CNY_PER_M=2
DEEPSEEK_FLASH_OUTPUT_CNY_PER_M=8
DEEPSEEK_PLUS_INPUT_CNY_PER_M=4
DEEPSEEK_PLUS_OUTPUT_CNY_PER_M=12

# 阿里云百炼新加坡业务空间。主要负责向量、联网、ASR、TTS，亦可作为显式选择的对话模型。
BAILIAN_WORKSPACE_ID=
BAILIAN_API_KEY=
BAILIAN_MODEL_FLASH=qwen3.7-flash
BAILIAN_MODEL_PLUS=qwen3.7-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_ASR_MODEL=qwen3-asr-flash
BAILIAN_TTS_MODEL=qwen3-tts-instruct-flash

# 任意 OpenAI Chat Completions 兼容服务。仅在 AGENT_MODEL_PROVIDER=custom 时使用。
OPENAI_COMPATIBLE_PROVIDER_NAME=custom-agent-model
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL_FLASH=
OPENAI_COMPATIBLE_MODEL_PLUS=
# 必须按服务真实能力声明，不能把不支持的多模态能力写进去。
OPENAI_COMPATIBLE_CAPABILITIES=text,streaming,tools,structuredOutput
OPENAI_COMPATIBLE_FLASH_INPUT_CNY_PER_M=0
OPENAI_COMPATIBLE_FLASH_OUTPUT_CNY_PER_M=0
OPENAI_COMPATIBLE_PLUS_INPUT_CNY_PER_M=0
OPENAI_COMPATIBLE_PLUS_OUTPUT_CNY_PER_M=0

# 每周知识发布接口签名密钥；不要提交真实值。
KNOWLEDGE_PUBLISH_HMAC_KEY=
# 只供本地每周发布脚本使用，例如 https://zqmusic.cn/api/admin/agent/knowledge/publish
KNOWLEDGE_PUBLISH_URL=

# 抖音网站应用审核通过后再配置；没有密钥时可先在站长页运行固定夹具演练。
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
