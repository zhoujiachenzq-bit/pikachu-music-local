# 监听地址与端口
HOST=127.0.0.1
PORT=3000

# 数据库位置；留空时使用 data/pikachu-music.sqlite
PIKACHU_DB_PATH=

# 公网部署时填写站点地址，并通过可信反向代理提供 HTTPS
APP_ORIGIN=
COOKIE_SECURE=false
TRUST_PROXY=

# 注册方式；需要邀请码时同时设置 REGISTRATION_INVITE_CODE
REGISTRATION_MODE=
REGISTRATION_INVITE_CODE=

# 可选备用音源，只监听本机回环地址
GO_MUSIC_API_URL=
GO_MUSIC_API_TIMEOUT_MS=7000
